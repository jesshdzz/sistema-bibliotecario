    "auth:schema": "auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts"
  },
  "dependencies": {
    "better-auth": "1.7.21",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "daisyui": "5.7.50",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.5.2"
